{
	"name": "@web-next-music/nmtools",
	"version": "5.0.0",
	"description": "Addon development tools for Next Music and Yandex Music Web",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"nmtools": "./bin/nmtools.js"
	},
	"main": "dist/cli.js",
	"files": ["bin", "dist"],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "tsc --noEmit && bun build src/cli.ts --target bun --outdir dist --format esm --minify",
		"format": "biome format --write .",
		"prepack": "npm run build"
	},
	"engines": {
		"node": ">=18"
	},
	"license": "MIT",
	"dependencies": {
		"@clack/prompts": "^0.10.1",
		"bun": "^1.3.0",
		"cac": "^6.7.14",
		"chokidar": "^4.0.3",
		"dotenv": "^18.0.7",
		"ignore": "^7.0.12",
		"mime-types": "^3.0.2",
		"sass": "^1.99.0",
		"tar": "^7.5.22",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/bun": "^1.1.0",
		"@types/mime-types": "^3.0.1",
		"typescript": "^6.0.2"
	}
}
